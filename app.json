{
  "expo": {
    "name": "BDMS",
    "slug": "bdms",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "platforms": [
      "ios",
      "android",
      "web"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.bdms.app"
    },
    "android": {
      "package": "com.bdms.app",
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION"
      ]
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
  "expo-asset",
  "expo-font",
  "expo-secure-store",
  "@react-native-community/datetimepicker",
  "expo-status-bar",
  "react-native-maps"
],
    "extra": {
      "eas": {
        "projectId": "aa907995-4a88-4970-866c-405c83b861f1"
      }
    },
    "owner": "naveed75"
  }
}
